NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Cloudflare Turnstile site key for the signup CAPTCHA. Falls back to
# Cloudflare's public test key (always passes) if unset — replace with your
# real site key from https://dash.cloudflare.com before launch, and enable
# CAPTCHA protection with the matching secret key in the Supabase dashboard
# under Authentication > Attack Protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAD-QB6cSmpiYO96c

# Analytics — GA4 measurement ID (analytics.google.com) and Microsoft
# Clarity project ID (clarity.microsoft.com). Both optional in dev; the
# scripts just don't render if unset.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
